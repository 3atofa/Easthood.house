PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5433
DB_NAME=easthood_house
DB_USER=postgres
DB_PASSWORD=

# JWT — JWT_SECRET and JWT_REFRESH_SECRET must be different
JWT_SECRET=
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRE=30d

# Mail (NodeMailer / Gmail app password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Easthood House <no-reply@easthood.house>"

# Seeded admin account
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Frontend
CLIENT_URL=http://localhost:4200
SITE_ORIGIN=http://localhost:4200

# Canonical origin, no trailing slash
SITE_URL=https://easthood.house

# IndexNow key (optional)
INDEXNOW_KEY=
