{
  "name": "easthood-backend",
  "version": "1.0.0",
  "description": "EAST HOOD \u2014 API for the public site and the admin portal",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:sync": "node src/database/sync.js",
    "db:seed": "node src/database/seed.js",
    "db:reset": "node src/database/sync.js --force && node src/database/seed.js",
    "setup": "npm run db:sync && npm run db:seed",
    "admin": "node src/database/create-admin.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^9.1.0",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  }
}
